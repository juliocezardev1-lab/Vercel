# Copie a URI exata em Supabase > Connect > Transaction pooler.
# Substitua a senha e os demais campos pelos valores do seu projeto.
DATABASE_URL=postgresql://postgres.REFERENCIA:SENHA@HOST_DO_POOLER:6543/postgres

# Apenas se o certificado do banco precisar de uma CA própria:
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nCONTEUDO\n-----END CERTIFICATE-----"

PORT=3000
