# Copy the exact Supabase PostgreSQL connection URI into BACKEND/.env.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres

# Optional private CA for a database provider that needs one.
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\nCERTIFICATE_CONTENT\n-----END CERTIFICATE-----"

PORT=3000
NODE_ENV=development

# Configure the matching Cloudflare Turnstile keys and site hostname per environment.
TURNSTILE_SITE_KEY=your-cloudflare-site-key
TURNSTILE_SECRET_KEY=your-cloudflare-secret-key
TURNSTILE_EXPECTED_HOSTNAME=your-site.example
RATE_LIMIT_SECRET=replace-with-a-random-64-character-secret

# Set these temporarily when running npm run create-admin; never commit real values.
ADMIN_IDENTIFIER=admin@example.invalid
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
